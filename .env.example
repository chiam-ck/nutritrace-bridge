# NutriTrace PostgreSQL data API configuration.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real credentials.

PG_HOST=your-postgres-host   # LAN / Tailscale IP or hostname of the Postgres box
PG_PORT=5432
PG_DB=nutritrace
PG_USER=nutritrace
PG_PASS=changeme             # set a real password here in .env
