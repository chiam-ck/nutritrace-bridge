      {
        "parameters": {
          "jsCode": "const b = $input.first().json.body;\nreturn [{\n  json: {\n    name: b.name,\n    nutrition: b.nutrition,\n    portion: b.portion || 100,\n    unit: b.unit || 'g',\n    category: b.category || '',\n    brand: b.brand || '',\n    notes: b.notes || '',\n    barcode: b.barcode || ''\n  }\n}];",
          "language": "javaScript",
          "mode": "runOnceForAllItems"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          300,
          1200
        ],
        "id": "0b96b4ad-5fb7-46d6-a965-39bb61454cc2",
        "name": "Add Body"
      },
      {
        "parameters": {
          "jsCode": "const b = $input.first().json.body;\nconst out = { id: b.id };\nfor (const k of ['name','category','portion','unit','brand','notes','barcode','nutrition']) {\n  if (b[k] !== undefined && b[k] !== null && b[k] !== '') out[k] = b[k];\n}\nreturn [{ json: out }];",
          "language": "javaScript",
          "mode": "runOnceForAllItems"
        },
        "type": "n8n-nodes-base.code",
